# =====================================================
# YYC³ 统一端口配置文件
# 创建日期: 2023-01-03
# 版本: 1.0.0
# 遵循YYC³标准：默认端口 3000-3007
# =====================================================

# -----------------------------------------------------
# 服务默认端口配置（开发环境）
# -----------------------------------------------------
# API服务
API_SERVICE_PORT=3000

# 邮件服务
MAIL_SERVICE_PORT=3003

# LLM服务
LLM_SERVICE_PORT=3002

# Redis API服务
REDIS_API_PORT=3379

# NAS服务
NAS_SERVICE_PORT=3009

# 管理服务
ADMIN_SERVICE_PORT=3001

# 监控服务
MONITOR_SERVICE_PORT=3003

# DDNS服务
DDNS_SERVICE_PORT=3007

# 日志服务
LOGS_SERVICE_PORT=3004

# 备份服务
BACKUP_SERVICE_PORT=3005

# Widget服务
WIDGET_SERVICE_PORT=3008

# -----------------------------------------------------
# FRP映射端口配置（生产环境）
# -----------------------------------------------------
# 注意：所有生产服务通过frp暴露到统一的域名端口
FRP_VHOST_HTTP_PORT=18080
FRP_VHOST_HTTPS_PORT=4443

# 服务映射端口（本地端口 -> frp服务器端口）
# 这些端口对应frpc.toml中的localPort配置
FRP_API_LOCAL_PORT=3000
FRP_MAIL_LOCAL_PORT=3003
FRP_LLM_LOCAL_PORT=3002
FRP_NAS_LOCAL_PORT=3004
FRP_ADMIN_LOCAL_PORT=3001
FRP_MONITOR_LOCAL_PORT=3003
FRP_DDNS_LOCAL_PORT=3007

# -----------------------------------------------------
# 服务域名配置
# -----------------------------------------------------
API_SERVICE_DOMAIN=api.naecs.com
MAIL_SERVICE_DOMAIN=mail.naecs.com
LLM_SERVICE_DOMAIN=llm.naecs.com
NAS_SERVICE_DOMAIN=nas.naecs.com
ADMIN_SERVICE_DOMAIN=admin.naecs.com
MONITOR_SERVICE_DOMAIN=monitor.naecs.com
DDNS_SERVICE_DOMAIN=ddns.naecs.com

# -----------------------------------------------------
# FRP服务配置
# -----------------------------------------------------
FRP_SERVER_HOST=8.152.195.33
FRP_SERVER_PORT=7001
FRP_SERVER_TOKEN=yyc3_nas
FRP_WEB_SERVER_PORT=7500
FRP_WEB_SERVER_USER=yyc3
FRP_WEB_SERVER_PASSWORD=my151001
