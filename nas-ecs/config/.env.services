# Docker Compose interpolation variables (not read by containers)
TZ=Asia/Shanghai
DOCKER_PLATFORM=linux/arm64/v8

# Host ports for mapped services
REDIS_DEV_PORT=6381
REDIS_PROD_PORT=6380
API_DEV_PORT=3000
API_PROD_PORT=3001

# Production password used by compose variable substitution
# Note: container env still loads from env_file: ../.env.local
REDIS_PROD_PASSWORD=redis_yyc3
