# ========================================
# YYC³ NAS-ECS Staging 环境配置
# ========================================
# 此文件包含 Staging 环境的所有配置
# 使用方法：
#   1. 复制此文件为 .env.staging
#   2. 根据实际环境修改配置值
#   3. 部署时使用: docker-compose -f docker-compose.staging.yml --env-file .env.staging up -d
# ========================================

# ======================
# 应用基础配置
# ======================
NODE_ENV=staging
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=debug
TZ=Asia/Shanghai

# ======================
# 数据库配置 (PostgreSQL)
# ======================
# 请根据实际情况修改以下配置
DATABASE_URL=postgresql://postgres:staging-password@postgres:5432/yyc3_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=staging-password-change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=yyc3_staging
DATABASE_POOL_SIZE=10

# ======================
# Redis 配置
# ======================
REDIS_URL=redis://:staging-redis-password@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=staging-redis-password
REDIS_DB=0

# ======================
# JWT 认证配置
# ======================
# ⚠️  Staging 环境使用测试密钥，生产环境必须更换！
JWT_SECRET_KEY=staging-jwt-secret-key-change-in-production-32chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ======================
# 应用密钥
# ======================
# ⚠️  Staging 环境使用测试密钥，生产环境必须更换！
SECRET_KEY=staging-secret-key-change-in-production-32characters
SESSION_SECRET=staging-session-secret-key-32chars-change-me

# ======================
# API 配置
# ======================
API_PREFIX=/api/v2
API_VERSION=2.0.0
API_PORT=3200
API_HOST=0.0.0.0
API_TIMEOUT=30000
API_RATE_LIMIT=100

# ======================
# CORS 配置
# ======================
# Staging 环境允许本地开发服务器
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://staging.yyc3.com
CORS_ENABLED=true
CORS_CREDENTIALS=true

# ======================
# LLM 服务配置
# ======================
# OpenAI API (如使用)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# 本地 Ollama (如使用)
OLLAMA_API_URL=http://ollama:11434
OLLAMA_MODEL=deepseek-r1:7b

# ======================
# 邮件服务配置
# ======================
# Staging 环境使用测试邮箱
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=staging@yyc3.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=staging@yyc3.com
SMTP_SECURE=true

# ======================
# 监控配置
# ======================
METRICS_ENABLED=true
METRICS_PORT=9090
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
HEALTH_CHECK_INTERVAL=30

# ======================
# 错误追踪 (Sentry)
# ======================
# Staging 环境启用追踪用于测试
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.5

# ======================
# 分布式追踪 (Jaeger)
# ======================
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_RATE=0.1

# ======================
# 备份配置
# ======================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_LOCAL_PATH=/opt/yyc3/backup/staging

# ======================
# DDNS 配置
# ======================
DDNS_ENABLED=true
DDNS_PROVIDER=duckdns
DDNS_DOMAIN=staging.yyc3.duckdns.org
DDNS_USERNAME=your-username
DDNS_PASSWORD=your-password
DDNS_UPDATE_INTERVAL=300

# ======================
# FRP 配置
# ======================
FRP_ENABLED=false
FRPC_PATH=/usr/local/bin/frpc
FRPS_CONFIG_PATH=/etc/frp/frps.toml

# ======================
# 文件存储配置
# ======================
NAS_MOUNT_POINT=/mnt/nas-staging
MAX_UPLOAD_SIZE=100MB
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.txt

# ======================
# 缓存配置
# ======================
CACHE_ENABLED=true
CACHE_TYPE=redis
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ======================
# 速率限制配置
# ======================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=100

# ======================
# 安全配置
# ======================
SECURE_COOKIE=true
CSRF_ENABLED=true
HELMET_ENABLED=true
XSS_PROTECTION_ENABLED=true
CONTENT_SECURITY_POLICY_ENABLED=true

# ======================
# 测试配置
# ======================
TESTING=false
FLASK_ENV=production
SQLALCHEMY_ECHO=false

# ======================
# Staging 特定配置
# ======================
# 允许详细日志用于调试
STAGING_DEBUG_LOGS=true

# 允许访问 Grafana
GRAFANA_ADMIN_PASSWORD=staging-admin-change-me

# 允许访问 Jaeger UI
JAEGER_UI_ENABLED=true

# ======================
# 功能开关
# ======================
FEATURE_USER_REGISTRATION=true
FEATURE_PASSWORD_RESET=true
FEATURE_API_ACCESS=true
FEATURE_MONITORING=true
FEATURE_LOGGING=true
FEATURE_BACKUP=true
FEATURE_TRACING=true

# ======================
# 第三方服务
# ======================
# GitHub (如果使用 GitHub OAuth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Services
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ======================
# Docker Compose 环境变量
# ======================
COMPOSE_PROJECT_NAME=yyc3-staging
COMPOSE_FILE=docker-compose.staging.yml

# ======================
# 性能配置
# ======================
# 工作进程数
WORKERS=2

# 请求超时
TIMEOUT=30

# 最大请求数
MAX_REQUESTS=1000

# 请求队列大小
BACKLOG=2048
